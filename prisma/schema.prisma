generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signature {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  company   String
  role      String
  email     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}