# .env.example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it must be in .gitignore.
# All variables listed here must also be added to Lagoon environment variables for production.
# After adding variables to Lagoon, a redeploy is required.

# ─── Auth.js ─────────────────────────────────────────────────────────────────

# Signing secret for Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required when running behind a reverse proxy (Lagoon). Set to 1 in Lagoon variables.
# In .env.local, omit this or leave it blank — it's only needed in deployed environments.
AUTH_TRUST_HOST=

# The canonical URL of this app. In .env.local, use the Docker hostname.
# In Lagoon production variables, use the production URL.
# Local:      http://<appname>.docker.amazee.io
# Production: https://node.main.<project-name>.ch4.amazee.io
NEXTAUTH_URL=

# ─── Okta SSO ────────────────────────────────────────────────────────────────
# Provided by IT after raising an Okta ticket. See docs/security/okta-oauth-implementation-guide.md

OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# e.g. https://login.yourcompany.io
OKTA_ISSUER=

# ─── Credentials login (temporary bridge until Okta is live) ─────────────────
# Used by the simple email/password gate before Okta SSO is available.
# Ask the user for the password, then hash it: node -e "require('bcryptjs').hash('PASSWORD', 12).then(console.log)"
# Never store the plaintext password here or anywhere.

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Set to "true" in Lagoon production variables to disable the credentials login once Okta is live.
NEXT_PUBLIC_ADMIN_LOGIN_DISABLED=

# ─── Database ────────────────────────────────────────────────────────────────
# Only needed if the project uses a database.
# Local Docker: postgres://<user>:<password>@<service-name>:5432/<dbname>
# Production:   set in Lagoon variables — never hardcode.

DATABASE_URL=

# Optional local Docker Compose defaults for the bundled Lagoon/PostgreSQL stack.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── External integrations ───────────────────────────────────────────────────
# Add keys for each external system this project integrates with.
# Document each integration in docs/security/security-and-access.md.

# Gate external writes during development — set to "true" only when ready.
# See docs/security/do-not-write.md
EXTERNAL_WRITES_ENABLED=

# Example integration keys — replace or remove as needed:
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=
# OPENAI_API_KEY=
# HUBSPOT_API_KEY=
# LAGOON_API_TOKEN=
