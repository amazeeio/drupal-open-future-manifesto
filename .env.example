# .env.example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it must be in .gitignore.
# All variables listed here must also be added to Lagoon environment variables for production.
# After adding variables to Lagoon, a redeploy is required.

# ─── Database ────────────────────────────────────────────────────────────────
# Only needed if the project uses a database.
# Local Docker: postgres://<user>:<password>@<service-name>:5432/<dbname>
# Production:   set in Lagoon variables — never hardcode.

DATABASE_URL=

# Optional local Docker Compose defaults for the bundled Lagoon/PostgreSQL stack.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── External integrations ───────────────────────────────────────────────────
# Add keys for each external system this project integrates with.
# Document each integration in docs/security/security-and-access.md.

# Gate external writes during development — set to "true" only when ready.
# See docs/security/do-not-write.md
EXTERNAL_WRITES_ENABLED=

# Example integration keys — replace or remove as needed:
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=
# OPENAI_API_KEY=
# HUBSPOT_API_KEY=
# LAGOON_API_TOKEN=
